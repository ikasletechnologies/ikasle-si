# Copy to .env.local (not committed) and add your key from NVIDIA Build.
# Keep this server-only: do not rename it to VITE_NVIDIA_API_KEY.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Contact form SMTP (server-only; never prefix these with VITE_)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IKASLE Website <no-reply@example.com>"
CONTACT_RECEIVER_EMAIL=